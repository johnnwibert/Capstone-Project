[sub_resource type="GDScript" id="GDScript_sylft"]
script/source = "extends CharacterBody2D
var WalkSpeed = 200.0
var DashSpeed = 1000.0
var dashing = false
var DashWait = false
var dir = 1
var lerprate = 0.2
var can_dash = true
var can_doublejump = false
var doublejumped = false
const SPEED = 250.0
const JUMP_VELOCITY = -350.0
@onready var animated_sprite: AnimatedSprite2D = $AgentAnimator/AnimatedSprite2D

func _ready():
	add_to_group(\"enemies\")

func _process(_delta: float) -> void:
	if Input.is_action_just_pressed(\"a\"):
		dir = -1
		animated_sprite.play(\"move_left\")
	if Input.is_action_just_pressed(\"d\"):
		dir = 1
		animated_sprite.play(\"move_right\")
	if !Input.is_action_pressed(\"a\") and !Input.is_action_pressed(\"d\"):
		animated_sprite.play(\"idle\")
	if Input.is_action_just_pressed(\"l\") and dashing == false and can_dash and !is_on_floor():
		dash()
	if is_on_floor():
		doublejumped = false
	if is_on_floor() and !can_dash:
		can_dash = true
	if !is_on_floor() and !doublejumped:
		can_doublejump = true

func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta
	# Handle jump.
	if Input.is_action_just_pressed(\"k\") and is_on_floor():
		can_doublejump = true
		velocity.y = JUMP_VELOCITY
	if Input.is_action_just_pressed(\"k\") and can_doublejump and !is_on_floor():
		can_doublejump = false
		velocity.y = JUMP_VELOCITY / 1.5
		doublejumped = true
	if dashing == false:
		if Input.is_action_pressed(\"a\") and !dashing == true:
			velocity.x = lerp(velocity.x, -WalkSpeed, lerprate)
		if Input.is_action_pressed(\"d\") and !dashing == true:
			velocity.x = lerp(velocity.x, WalkSpeed, lerprate)
		elif !Input.is_action_pressed(\"a\") and !Input.is_action_pressed(\"d\"):
			velocity.x = lerp(velocity.x, 0.0, 0.1)
	if (position.y >= 512):
		position = Vector2(200, -320)
		set_physics_process(false)
		await get_tree().create_timer(0.5).timeout
		set_physics_process(true)
	move_and_slide()
func dash():
	can_dash = false
	dashing = true
	velocity.x = DashSpeed * dir 
	velocity.x = lerp(velocity.x, 0.0, 0.05)
	dashing = false
	pass
	
"

